<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks cleartext HTTP by default. TheTVDB is HTTPS and is
  unaffected either way. Kodi's JSON-RPC control interface, however, is
  plain HTTP and the user can point it at any host on their LAN (usually
  the TV itself at 127.0.0.1, but Kodi can also run on a separate box) -
  so rather than trying to enumerate private IP ranges, cleartext is
  permitted app-wide. This has no effect on TLS certificate validation
  for the HTTPS calls this app makes.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
